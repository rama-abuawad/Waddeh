# Local Waddeh connection settings — no external account is required for these.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# Firebase Web configuration (public identifiers, not service-account secrets).
# Create a Firebase Web App, then copy these values from Project settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side language and speech configuration. Keep GEMINI_API_KEY secret.
AI_MODEL=gemini-3.6-flash
AI_FALLBACK_MODEL=gemini-3.5-flash
AI_TTS_MODEL=gemini-3.1-flash-tts-preview
AI_TTS_ARABIC_VOICE=Sulafat
AI_TTS_ENGLISH_VOICE=Sulafat
GEMINI_API_KEY=
