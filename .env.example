# Frontend: safe, public configuration only
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
APP_ENV=development
APP_NAME=Waddeh API
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Gemini — backend only; never expose this with a NEXT_PUBLIC_ name
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=

# Future server-side integrations
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
